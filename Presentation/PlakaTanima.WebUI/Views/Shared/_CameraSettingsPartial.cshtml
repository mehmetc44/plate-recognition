<div class="camera-settings-layout">
    <!-- Lokasyonlar Tablosu Bölümü -->
    <div class="settings-table-card">
        <div class="settings-table-header">
            <h3><i class="fas fa-map-marker-alt"></i> Lokasyon Yönetimi</h3>
            <button id="globalAddLocationBtn" class="py-btn-primary" title="Yeni Lokasyon Ekle">
                <i class="fas fa-plus"></i> Yeni Lokasyon Ekle
            </button>
        </div>
        <div class="table-wrapper">
            <table class="camera-table" id="locationsTable">
                <thead>
                    <tr>
                        <th>Lokasyon Adı</th>
                        <th>Açıklama</th>
                        <th style="width: 140px; text-align: center;">Kamera Sayısı</th>
                        <th style="width: 140px; text-align: center;">İşlemler</th>
                    </tr>
                </thead>
                <tbody id="locationsTableBody">
                    <!-- Dinamik doldurulacaktır -->
                    <tr>
                        <td colspan="4" style="text-align: center; color: var(--text-secondary); padding: 20px;">Lokasyonlar yükleniyor...</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

    <!-- Kameralar Tablosu Bölümü -->
    <div class="settings-table-card" id="camerasSection" style="margin-top: 16px;">
        <div class="settings-table-header">
            <h3><i class="fas fa-video"></i> <span id="selectedLocationTitle">Kameralar</span></h3>
            <button id="addCameraFromDetailBtn" class="py-btn-primary" disabled>
                <i class="fas fa-plus"></i> Kamera Ekle
            </button>
        </div>
        <div class="table-wrapper">
            <table class="camera-table" id="camerasTable">
                <thead>
                    <tr>
                        <th style="width: 250px;">ID</th>
                        <th>Kamera Adı</th>
                        <th>IP Adresi</th>
                        <th style="width: 100px;">Port</th>
                        <th style="width: 140px; text-align: center;">Durum</th>
                        <th style="width: 140px; text-align: center;">İşlemler</th>
                    </tr>
                </thead>
                <tbody id="detailCameraTableBody">
                    <tr>
                        <td colspan="6" style="text-align: center; color: var(--text-secondary); padding: 20px;">Lütfen yukarıdan bir lokasyon seçin.</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Lokasyon Düzenleme Modal -->
<div id="editLocationModal" class="modal" style="display:none;">
    <div class="modal-content">
        <div class="modal-header"><span>Lokasyon Düzenle</span><span class="close-modal">&times;</span></div>
        <div class="modal-body">
            <input type="hidden" id="editLocationId" />
            <div class="form-group">
                <label>Lokasyon Adı</label>
                <input type="text" id="editLocationName" class="modal-input" required />
            </div>
            <div class="form-group">
                <label>Açıklama</label>
                <textarea id="editLocationDesc" class="modal-input" rows="3"></textarea>
            </div>
        </div>
        <div class="modal-footer">
            <button id="updateLocationBtn" class="btn-save-modal">Güncelle</button>
            <button type="button" class="btn-cancel-modal">İptal</button>
        </div>
    </div>
</div>

<!-- Lokasyon Ekleme Modal -->
<div id="locationModal" class="modal" style="display:none;">
    <div class="modal-content">
        <div class="modal-header"><span>Lokasyon Ekle</span><span class="close-modal">&times;</span></div>
        <div class="modal-body">
            <div class="form-group">
                <label>Lokasyon Adı</label>
                <input type="text" id="locationNameInput" class="modal-input" required />
            </div>
            <div class="form-group">
                <label>Açıklama</label>
                <textarea id="locationDescInput" class="modal-input" rows="3"></textarea>
            </div>
        </div>
        <div class="modal-footer">
            <button id="saveLocationBtn" class="btn-save-modal">Kaydet</button>
            <button type="button" class="btn-cancel-modal">İptal</button>
        </div>
    </div>
</div>

<!-- Kamera Ekleme/Düzenleme Modal -->
<div id="cameraModal" class="modal" style="display:none;">
    <div class="modal-content">
        <div class="modal-header"><span>Kamera Ekle/Düzenle</span><span class="close-modal-cam">&times;</span></div>
        <div class="modal-body">
            <input type="hidden" id="cameraId" />
            <input type="hidden" id="cameraLocationId" />
            <div class="form-group">
                <label>Kamera Adı</label>
                <input type="text" id="cameraNameInput" class="modal-input" required />
            </div>
            <div class="form-group">
                <label>IP Adresi</label>
                <input type="text" id="cameraIpInput" class="modal-input" required />
            </div>
            <div class="form-group">
                <label>Port</label>
                <input type="number" id="cameraPortInput" class="modal-input" value="80" />
            </div>
            <div class="form-group">
                <label>Kullanıcı Adı</label>
                <input type="text" id="cameraUsernameInput" class="modal-input" />
            </div>
            <div class="form-group">
                <label>Şifre</label>
                <input type="password" id="cameraPasswordInput" class="modal-input" />
            </div>
        </div>
        <div class="modal-footer">
            <button id="saveCameraBtn" class="btn-save-modal">Kaydet</button>
            <button type="button" class="btn-cancel-modal-cam">İptal</button>
        </div>
    </div>
</div>
