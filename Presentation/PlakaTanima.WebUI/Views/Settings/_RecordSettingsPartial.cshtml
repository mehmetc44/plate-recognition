<section class="settings-panel" id="panel-recording">
    <div class="settings-group">
        <h3 class="settings-group-title"><i class="fas fa-hdd"></i> Kayıt Yönetimi</h3>
        <div class="settings-row">
            <div class="settings-label"><span>Sürekli Kayıt</span><small>7/24 video kaydı yap</small></div><label
            class="toggle-switch"><input type="checkbox"><span class="toggle-slider"></span></label>
        </div>
        <div class="settings-row">
            <div class="settings-label"><span>Olay Bazlı Kayıt</span><small>Sadece plaka tespit edildiğinde
                kaydet</small></div><label class="toggle-switch"><input type="checkbox" checked><span
                class="toggle-slider"></span></label>
            </div>
            <div class="settings-row">
                <div class="settings-label"><span>Kayıt Saklama Süresi</span><small>Kaç gün boyunca kayıt tutulsun</small>
                </div><select class="settings-select">
                <option>7 Gün</option>
                <option selected>30 Gün</option>
                <option>90 Gün</option>
            </select>
        </div>
    </div>
    <div class="settings-group">
        <h3 class="settings-group-title"><i class="fas fa-chart-line"></i> Kayıt Kalitesi</h3>
        <div class="settings-row">
            <div class="settings-label"><span>Video Kalitesi</span><small>Kayıt edilen videoların kalitesi</small></div>
            <select class="settings-select">
                <option>Düşük (720p)</option>
                <option selected>Orta (1080p)</option>
                <option>Yüksek (4K)</option>
            </select>
        </div>
    </div>
</section>