<section class="settings-panel" id="panel-appearance">
    <div class="settings-group">
        <h3 class="settings-group-title"><i class="fas fa-palette"></i> Tema Seçimi</h3>
        <div class="theme-grid" id="themeGrid">
            <button class="theme-card active" data-theme="light">
                <div class="theme-preview" data-preview="light"><span class="prev-surface"></span><span
                    class="prev-text"></span><span class="prev-accent"></span><span class="prev-border"></span>
                </div><span class="theme-name">Açık</span>
            </button>
            <button class="theme-card" data-theme="ocean">
                <div class="theme-preview" data-preview="ocean"><span class="prev-surface"></span><span
                    class="prev-text"></span><span class="prev-accent"></span><span class="prev-border"></span>
                </div><span class="theme-name">Okyanus</span>
            </button>
            <button class="theme-card" data-theme="forest">
                <div class="theme-preview" data-preview="forest"><span class="prev-surface"></span><span
                    class="prev-text"></span><span class="prev-accent"></span><span class="prev-border"></span>
                </div><span class="theme-name">Orman</span>
            </button>
            <button class="theme-card" data-theme="royal">
                <div class="theme-preview" data-preview="royal"><span class="prev-surface"></span><span
                    class="prev-text"></span><span class="prev-accent"></span><span class="prev-border"></span>
                </div><span class="theme-name">Kraliyet</span>
            </button>
            <button class="theme-card" data-theme="sunset">
                <div class="theme-preview" data-preview="sunset"><span class="prev-surface"></span><span
                    class="prev-text"></span><span class="prev-accent"></span><span class="prev-border"></span>
                </div><span class="theme-name">Gün Batımı</span>
            </button>
            <button class="theme-card" data-theme="slate">
                <div class="theme-preview" data-preview="slate"><span class="prev-surface"></span><span
                    class="prev-text"></span><span class="prev-accent"></span><span class="prev-border"></span>
                </div><span class="theme-name">Kurumsal</span>
            </button>
        </div>
        <div class="settings-row" style="margin-top:16px">
            <div class="settings-label"><span>Koyu Varyant</span><small>Seçili temanın koyu sürümünü kullan</small>
            </div>
            <label class="toggle-switch"><input type="checkbox" id="darkModeToggle"><span
                class="toggle-slider"></span></label>
            </div>
        </div>

        <div class="settings-group">
            <h3 class="settings-group-title"><i class="fas fa-tint"></i> Vurgu Rengi</h3>
            <div class="settings-row">
                <div class="settings-label"><span>Renk Seçimi</span><small>Arayüz vurgu rengini seçin</small></div>
                <div class="color-picker-group">
                    <button class="color-dot active" data-accent="blue" style="background:#2196F3"></button>
                    <button class="color-dot" data-accent="red" style="background:#E53935"></button>
                    <button class="color-dot" data-accent="green" style="background:#43A047"></button>
                    <button class="color-dot" data-accent="orange" style="background:#FB8C00"></button>
                    <button class="color-dot" data-accent="purple" style="background:#8E24AA"></button>
                    <button class="color-dot" data-accent="cyan" style="background:#00ACC1"></button>
                    <button class="color-dot" data-accent="pink" style="background:#D81B60"></button>
                </div>
            </div>
        </div>

        <div class="settings-group">
            <h3 class="settings-group-title"><i class="fas fa-text-height"></i> Görüntüleme</h3>
            <div class="settings-row">
                <div class="settings-label"><span>Tablo Yoğunluğu</span><small>Veri tablolarının satır yüksekliği</small>
                </div>
                <div class="density-group"><button class="density-btn" data-density="compact">Sıkışık</button><button
                    class="density-btn active" data-density="normal">Normal</button><button class="density-btn"
                                                                                            data-density="comfortable">Rahat</button></div>
                </div>
                <div class="settings-row">
                    <div class="settings-label"><span>Sidebar Konumu</span><small>Kamera listesinin konumu</small></div><select
                    class="settings-select">
                    <option value="left" selected>Sol</option>
                    <option value="right">Sağ</option>
                </select>
            </div>
            <div class="settings-row">
                <div class="settings-label"><span>Animasyonlar</span><small>Arayüz geçiş animasyonlarını etkinleştir</small>
                </div><label class="toggle-switch"><input type="checkbox" checked><span
                class="toggle-slider"></span></label>
            </div>
        </div>
    </section>