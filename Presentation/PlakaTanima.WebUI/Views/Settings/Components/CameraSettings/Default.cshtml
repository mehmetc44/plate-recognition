@using PlakaTanima.Application.Features.Locations.Queries.GetLocationList
@model List<GetLocationListResponse>

<section class="settings-panel" id="panel-camera">
    <div class="camera-settings-split">
        <!-- Sol ağaç paneli -->
        <div class="camera-tree-panel">
            <div class="tree-header">
                <h3><i class="fas fa-map-marker-alt"></i> Lokasyonlar</h3>
                <button id="globalAddLocationBtn" class="btn-icon-sm" title="Yeni Lokasyon"><i
                    class="fas fa-plus"></i></button>
                </div>
                <div class="camera-list-search">
                    <i class="fas fa-search search-icon"></i>
                    <input type="text" id="locationSearchTree" placeholder="Lokasyon ara...">
                </div>
                <ul class="camera-tree" id="locationTree">
                    <!-- Dinamik ağaç buraya gelecek -->
                    @foreach (var location in Model)
                    {
                        <li data-id="@location.Id">@location.Name</li>
                    }
                </ul>
            </div>

            <!-- Sağ detay paneli -->
            <div class="location-detail-panel" id="locationDetailPanel">
                <div class="location-detail-card" id="locationDetailCard">
                    <div class="detail-header">
                        <h2 id="detailLocationName">Lokasyon seçin</h2>
                        <div class="detail-actions">
                            <button id="editLocationBtn" class="btn-outline-sm" disabled><i class="fas fa-edit"></i>
                                Düzenle</button>
                                <button id="deleteLocationBtn" class="btn-outline-sm danger" disabled><i
                                    class="fas fa-trash"></i> Sil</button>
                                </div>
                            </div>
                            <div class="detail-field">
                                <label>Açıklama</label>
                                <p id="detailLocationDesc">Bir lokasyon seçtiğinizde detaylar burada görünür.</p>
                            </div>
                            <div class="camera-section-header">
                                <h3><i class="fas fa-video"></i> Kameralar</h3>
                                <button id="addCameraFromDetailBtn" class="btn-primary-sm" disabled><i class="fas fa-plus"></i>
                                    Kamera Ekle</button>
                                </div>
                                <div class="camera-table-wrapper">
                                    <table class="camera-table">
                                        <thead>
                                            <tr>
                                                <th>ID</th>
                                                <th>Adı</th>
                                                <th>IP Adresi</th>
                                                <th>Port</th>
                                                <th>Durum</th>
                                                <th>İşlemler</th>
                                            </tr>
                                        </thead>
                                        <tbody id="detailCameraTableBody">
                                            <tr>
                                                <td colspan="6">Lokasyon seçin</td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>