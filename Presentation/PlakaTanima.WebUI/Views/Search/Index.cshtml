<div class="table-container" id="advancedSearchPage">
    <div class="table-header">
        <h2><i class="fas fa-search"></i> Gelişmiş Araç Sorgu</h2>

        <div class="advanced-search-actions">
            <button type="button" class="btn btn-secondary" id="btnClearFilters">
                <i class="fas fa-eraser"></i> Temizle
            </button>
            <button type="button" class="btn btn-primary" id="btnSearch">
                <i class="fas fa-filter"></i> Sorgula
            </button>
        </div>
    </div>

    <section class="advanced-search-filters">
        <div class="filter-row">
            <div class="filter-group">
                <label class="filter-label" for="plateQuery">Plaka</label>
                <div class="filter-control">
                    <i class="fas fa-car filter-icon"></i>
                    <input id="plateQuery" class="filter-input" type="text" placeholder="Örn: 34 ABC 123">
                </div>
            </div>

            <div class="filter-group">
                <label class="filter-label" for="dateFrom">Başlangıç</label>
                <div class="filter-control">
                    <i class="fas fa-calendar-alt filter-icon"></i>
                    <input id="dateFrom" class="filter-input" type="date">
                </div>
            </div>

            <div class="filter-group">
                <label class="filter-label" for="dateTo">Bitiş</label>
                <div class="filter-control">
                    <i class="fas fa-calendar-check filter-icon"></i>
                    <input id="dateTo" class="filter-input" type="date">
                </div>
            </div>

            <div class="filter-group">
                <label class="filter-label" for="plateStatus">Plaka Durumu</label>
                <div class="filter-control">
                    <i class="fas fa-tag filter-icon"></i>
                    <select id="plateStatus" class="filter-input">
                        <option value="all">Tümü</option>
                        <option value="normal">Normal</option>
                        <option value="vip">Özel</option>
                        <option value="blacklist">Kara Liste</option>
                    </select>
                </div>
            </div>
        </div>

        <div class="filter-meta">
            <div class="filter-count" id="resultCount">5 sonuç listelendi</div>
            <div class="filter-hint">
                Plaka alanında boşluk/harf duyarsız arama yapılır.
            </div>
        </div>
    </section>

    <div class="table-wrapper">
        <table class="vehicle-table">
            <thead>
                <tr>
                    <th>Plaka</th>
                    <th>Tarih &amp; Saat</th>
                    <th>Geçiş Noktası</th>
                    <th>Yön</th>
                    <th>Durum (Etiket)</th>
                </tr>
            </thead>
            <tbody id="vehicleResults">
                <tr>
                    <td><span class="plate-label plate-warning">21 AAA 001</span></td>
                    <td class="monospace">19.03.2026 21:10:45</td>
                    <td>Ana Giriş</td>
                    <td><span class="text-success"><i class="fas fa-arrow-right"></i> Giriş</span></td>
                    <td><span class="badge badge-vip"><i class="fas fa-star"></i> Özel</span></td>
                </tr>

                <tr>
                    <td><span class="plate-label">34 ABC 123</span></td>
                    <td class="monospace">19.03.2026 21:05:12</td>
                    <td>Otopark Çıkış</td>
                    <td><span class="text-danger"><i class="fas fa-arrow-left"></i> Çıkış</span></td>
                    <td><span class="badge badge-normal"><i class="fas fa-check-circle"></i> Normal</span></td>
                </tr>

                <tr>
                    <td><span class="plate-label plate-danger">06 XYZ 987</span></td>
                    <td class="monospace">19.03.2026 20:58:30</td>
                    <td>Arka Kapı</td>
                    <td><span class="text-success"><i class="fas fa-arrow-right"></i> Giriş</span></td>
                    <td><span class="badge badge-alert"><i class="fas fa-exclamation-triangle"></i> Kara Liste</span>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</div>
@section PageStyles {
    <link rel="stylesheet" href="~/css/AdvancedSearch.css" />
}
@section PageScripts {
    <script src="~/js/Index.js"></script>
}