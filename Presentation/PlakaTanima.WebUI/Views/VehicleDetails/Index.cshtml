@{
    ViewData["Title"] = "Araç Detayı";
    Layout = null; // Detay sayfası kendi layout'una sahip
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Araç Detayı - Plaka Tanıma Sistemi</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/Theme.css">
    <link rel="stylesheet" href="~/css/Utils.css">
    <link rel="stylesheet" href="~/css/arac_detay.css">
</head>
<body>
    <!-- Ana Yapı -->
    <main class="detail-main">

        <!-- ========== ÜST BAR ========== -->
        <header class="detail-topbar">
            <div class="topbar-left">
                <div class="topbar-info">
                    <span class="topbar-plate" id="topbarPlate">-</span>
                    <span class="topbar-location" id="topbarLocation">
                        <i class="fas fa-map-marker-alt"></i> -
                    </span>
                    <span class="topbar-badge" id="topbarBadge">
                        -
                    </span>
                </div>
            </div>

            <button class="close-btn" onclick="window.close()" title="Kapat">
                <i class="fas fa-times"></i>
            </button>
        </header>

        <!-- ========== İÇERİK ========== -->
        <div class="detail-content">

            <!-- ÜST GRID: Medya + Bilgi Paneli -->
            <div class="detail-top-grid">

                <!-- ========== MEDYA KARTI ========== -->
                <div class="media-card">
                    <div class="media-card-header">
                        <div class="media-card-title">
                            <i class="fas fa-image"></i>
                            <span id="viewModeLabel">Sahne Görünümü</span>
                        </div>

                        <div class="view-mode-tabs">
                            <button class="view-mode-btn active" data-type="scene">Sahne</button>
                            <button class="view-mode-btn" data-type="vehicle">Araç</button>
                            <button class="view-mode-btn" data-type="plate">Plaka</button>
                        </div>
                    </div>

                    <div class="media-card-body">
                        <img src="" class="viewer-img scene active-view" data-view="scene" id="imgScene" alt="Sahne görünümü" style="max-height: 400px; object-fit: contain;">
                        <img src="" class="viewer-img vehicle" data-view="vehicle" id="imgVehicle" alt="Araç görünümü" style="max-height: 400px; object-fit: contain;">
                        <img src="" class="viewer-img plate" data-view="plate" id="imgPlate" alt="Plaka görünümü" style="max-height: 400px; object-fit: contain;">
                    </div>
                </div>

                <!-- ========== BİLGİ KARTI ========== -->
                <div class="info-card">
                    <div class="info-card-header">
                        <span class="info-plate" id="infoPlate">-</span>
                        <span class="info-badge" id="infoBadge">
                            -
                        </span>
                    </div>

                    <div class="info-grid">
                        <div class="info-item">
                            <span class="info-label">Marka / Model</span>
                            <span class="info-value" id="infoModel">-</span>
                        </div>
                        <div class="info-item">
                            <span class="info-label">Sahip / Sürücü</span>
                            <span class="info-value" id="infoOwner">-</span>
                        </div>
                        <div class="info-item">
                            <span class="info-label">Kayıt Tarihi</span>
                            <span class="info-value monospace" id="infoRecordDate">-</span>
                        </div>
                        <div class="info-item">
                            <span class="info-label">Son Görülme</span>
                            <span class="info-value" id="infoLastSeen">-</span>
                        </div>
                    </div>

                    <div class="info-actions">
                        <button class="btn-primary-action" id="btnPlayVideo" style="display:none;">
                            <i class="fas fa-play"></i> Son Videoyu Oynat
                        </button>
                        <button class="btn-secondary-action" onclick="window.print()">
                            <i class="fas fa-print"></i> Rapor Al / Yazdır
                        </button>
                        <button class="btn-danger-action" id="btnToggleBlacklist">
                            <i class="fas fa-ban"></i> Kara Listeye Ekle
                        </button>
                    </div>
                </div>
            </div>

            <!-- ========== GEÇİŞ GEÇMİŞİ ========== -->
            <div class="history-card">
                <div class="history-card-header">
                    <i class="fas fa-history"></i>
                    <span>Geçiş Geçmişi (Son 10 Geçiş)</span>
                </div>

                <div class="history-table-wrapper">
                    <table class="history-table">
                        <thead>
                            <tr>
                                <th>Tarih / Saat</th>
                                <th>Kamera Noktası</th>
                                <th>Yön</th>
                                <th>Durum</th>
                                <th>Detay</th>
                            </tr>
                        </thead>
                        <tbody id="historyTableBody">
                            <!-- JS ile doldurulacak -->
                        </tbody>
                    </table>
                </div>
            </div>

        </div>
    </main>

    <script src="~/js/core/theme.js"></script>
    <script src="~/js/pages/vehicle-details.js"></script>
    <script src="~/js/core/layout.js"></script>
</body>
</html>
