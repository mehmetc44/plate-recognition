@{
    ViewData["Title"] = "Canlı Akış";
}

<main>
    @await Component.InvokeAsync("CameraList", new { cameras = Model.cameras })
    <div class="content-area" id="contentArea">
        <partial name="_ToolBoxPartial" />
        @await Component.InvokeAsync("LiveStream")
        @await Component.InvokeAsync("PlateStream")
        @await Component.InvokeAsync("LiveTableStream")
    </div>

    @await Component.InvokeAsync("DetectionFeed")
</main>

@section PageStyles {
    <link rel="stylesheet" href="~/css/Index.css" />
}

@section PageScripts {
<!-- CDN üzerinden SignalR (Dosya yolu derdi yok) -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
    
    <!-- Senin dosyan -->
    <script src="~/js/SignalR/Detection.js"></script>
    <script src="~/js/Index.js"></script>
    <script src="~/js/Camera-Stream.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/hls.js@latest"></script>
}