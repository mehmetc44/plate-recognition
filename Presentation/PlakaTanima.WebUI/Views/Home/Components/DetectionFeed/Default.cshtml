<aside class="detection-feed">
    <h3 class="feed-title"><i class="fas fa-bell"></i> Tespit Akışı</h3>
    <div id="detectionFeed" style="display: flex; flex-direction: column; gap: 14px;">
        <div class="vehicle-card status-danger">
            <!-- Dynamic Status Badge -->
            <span class="badge badge-alert badge-absolute">
                <i class="fas fa-ban"></i> KARA LİSTE
            </span>

            <!-- Vehicle Snapshot Image -->
            <img src="img/full.jpeg" alt="Araç" class="vehicle-img">

            <div class="vehicle-info">
                <!-- Plate Monospace Label -->
                <div class="plate-label plate-danger">06 XYZ 987</div>
                
                <!-- Camera Location -->
                <div class="text-success small mt-1">
                    <i class="fas fa-arrow-left"></i> Otopark Çıkış
                </div>
                
                <!-- Detection DateTime -->
                <div class="text-muted small">
                    <i class="far fa-clock"></i> 30.06.2026 13:42:15
                </div>
            </div>
        </div>
    </div>
</aside>