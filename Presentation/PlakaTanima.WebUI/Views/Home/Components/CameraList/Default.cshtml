<aside class="camera-list">
    <h1><i class="fas fa-sitemap"></i> Resource</h1>
    <div class="camera-list-search">
        <i class="fas fa-search search-icon"></i>
        <input type="text" id="cameraSearch" placeholder="Kamera ara...">
    </div>
    <ul class="camera-tree">
        <li>
            <div class="camera-tree-node nvr-toggle">
                <span class="caret"></span>
                <i class="fas fa-server"></i> NVR
            </div>
            <ul class="nested">
                <li class="camera-item online" data-camera-id="1"><i class="fas fa-video"></i> Camera 1</li>
                <li class="camera-item offline" data-camera-id="1"><i class="fas fa-video"></i> Camera 2</li>
                <li class="camera-item offline" data-camera-id="1"><i class="fas fa-video"></i> Camera 3</li>
            </ul>
        </li>
    </ul>
</aside>