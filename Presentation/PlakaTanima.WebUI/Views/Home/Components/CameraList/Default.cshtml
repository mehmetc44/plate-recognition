@model IEnumerable<PlakaTanima.Domain.Entities.Location>

<aside class="camera-list">
    <h1><i class="fas fa-sitemap"></i> KAYNAKLAR</h1>
    <div class="camera-list-search">
        <i class="fas fa-search search-icon"></i>
        <input type="text" id="cameraSearch" placeholder="Kamera veya IP ara...">
    </div>
    <div style="flex: 1; overflow-y: auto; width: 100%;">
        <ul class="tree-menu" id="homeCameraTree">
            
            <li class="tree-item" id="mapNode">
                <i class="fa-solid fa-map"></i> Harita Görünümü
            </li>

            @foreach (var location in Model)
            {
                var onlineCount = location.Cameras.Count(c => c.Status.ToString().ToLower() == "online");
                var totalCount = location.Cameras.Count;
                var hasOffline = location.Cameras.Any(c => c.Status.ToString().ToLower() == "offline");

                <li>
                    <details open>
                        <summary class="tree-item">
                            <span class="icon-wrapper">
                                <i class="fa-solid fa-server"></i>
                                @if (hasOffline)
                                {
                                    <span class="badge red">!</span>
                                }
                            </span>
                            @location.Name (@onlineCount/@totalCount)
                        </summary>
                        <ul class="tree-nested">
                            @if (!location.Cameras.Any())
                            {
                                <li class="tree-item offline" style="opacity: 0.5; pointer-events: none; padding-left: 29px;">
                                    <i class="fa-solid fa-video-slash"></i> Kamera Yok
                                </li>
                            }
                            else
                            {
                                @foreach (var camera in location.Cameras)
                                {
                                    var isOnline = camera.Status.ToString().ToLower() == "online";
                                    var iconClass = isOnline ? "fa-video" : "fa-circle-exclamation";
                                    var iconColor = isOnline ? "#62c462" : "#e74c3c";

                                    <li class="tree-item camera-item @camera.Status.ToString().ToLower()" 
                                        data-camera-id="@camera.Id" 
                                        data-ip="@camera.IpAddress" 
                                        data-port="@camera.Port" 
                                        data-channel="@camera.StreamChannel"
                                        style="display: flex; justify-content: space-between; align-items: center; padding-left: 29px;">
                                        <span style="display: flex; align-items: center; gap: 6px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                                            <i class="fa-solid @iconClass" style="color: @iconColor; margin-right: 8px;"></i>
                                            <span>@camera.Name</span>
                                        </span>
                                        <small style="font-family: monospace; font-size: 0.72rem; opacity: 0.6; margin-left: auto; padding-left: 6px;">@camera.IpAddress</small>
                                    </li>
                                }
                            }
                        </ul>
                    </details>
                </li>
            }

        </ul>
    </div>
</aside>