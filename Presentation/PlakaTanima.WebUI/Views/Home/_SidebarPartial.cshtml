
<div class="sidebar">
        <div class="sidebar-header">
            <i class="fas fa-sitemap"></i> Resource
        </div>

        <div class="sidebar-search">
            <i class="fas fa-search search-icon"></i>
            <input type="text" id="cameraSearch" placeholder="Kamera ara...">
        </div>

        <ul class="tree-view">
            <li>
                <div class="tree-node">
                    <span class="caret"></span>
                    <i class="fas fa-server"></i> NVR (12/@Model.cameras.Count)
                </div>
                <ul class="nested">
                    @foreach (var camera in Model.cameras)
                    {
                        <li class="camera-item" data-id="@camera.IP" data-name="@camera.Name">
                            <i class="fas fa-video"></i> @camera.Name
                        </li>
                    }
                </ul>
            </li>
        </ul>
    </div>